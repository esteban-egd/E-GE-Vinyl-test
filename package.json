{
  "name": "e-ge-vinyl",
  "private": true,
  "version": "0.2.0",
  "description": "E-GE Vinyl Player App",
  "author": "E-GE Vinyl",
  "type": "module",
  "main": "Lyra-Source-Code/electron-build/electron-main.cjs",
  "build": {
    "appId": "com.egevinyl.app",
    "productName": "E-GE Vinyl",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "Lyra-Source-Code/electron-build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/hash-wasm/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:vite": "vite build",
    "build:desktop": "vite build && electron-builder",
    "electron:dev": "vite build && electron .",
    "electron:build": "vite build && electron-builder --win",
    "start": "node dist/server.cjs",
    "lint": "oxlint",
    "preview": "vite preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "@aracna/core": "^1.5.0",
    "@aracna/fcm": "^1.0.33",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@distube/ytdl-core": "^4.16.12",
    "@supabase/supabase-js": "^2.112.4",
    "cors": "^2.8.6",
    "dexie": "^4.4.5",
    "discord-rpc": "^4.0.1",
    "electron-context-menu": "^4.1.2",
    "electron-is-dev": "^3.0.1",
    "electron-store": "^11.0.2",
    "electron-unhandled": "^5.0.0",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "express": "^5.2.1",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.1",
    "music-metadata": "^11.15.0",
    "node-machine-id": "^1.1.12",
    "play-dl": "^1.9.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.3.3",
    "youtubei.js": "^18.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^35.0.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.12",
    "vite": "^8.2.0"
  },
  "optionalDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.5",
    "lightningcss-win32-x64-msvc": "^1.33.0"
  }
}
